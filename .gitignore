# =============================================================================
# PDF Chatbot 2 — Git Ignore Rules
# =============================================================================

# --- Data & PDF Documents ---
# Keep data/pdfs/ directory in git via .gitkeep, ignore all PDF files & subdirectories
data/*
!data/pdfs/
data/pdfs/*
!data/pdfs/.gitkeep
*.pdf

# --- Logs & Runtime Output ---
# Keep logs/ directory in git via .gitkeep, ignore all log files
logs/*
!logs/.gitkeep
*.log

# --- Vector Store & BM25 Indexes ---
# Keep vectorstore/ directory in git via .gitkeep, ignore generated indexes
vectorstore/*
!vectorstore/.gitkeep
*.pkl
*.sqlite3
chroma.sqlite3

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Agent State & Customizations (Internal tooling) ---
.agents/
AGENT_STATE.md

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/

# --- OS-Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Model & HuggingFace Caches ---
.cache/
hf_cache/
models/
huggingface/
.ollama/

# --- Scratch & Testing Artifacts ---
scratch/
scratch_*.py
*.tmp
*.png
*.webp
*.zip
comparison_report.md
vectorstore_export.zip

# --- Docker ---
.dockerignore
docker-data/
*.tar
pdf_chatbot_ollama/
pdf_chatbot_huggingface/
